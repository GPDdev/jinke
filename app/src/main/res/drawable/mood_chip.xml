<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape><solid android:color="@color/selected" /><corners android:radius="24dp" /><stroke android:width="1dp" android:color="@color/accent" /></shape>
    </item>
    <item><shape><solid android:color="@color/surface" /><corners android:radius="24dp" /><stroke android:width="1dp" android:color="@color/border" /></shape></item>
</selector>
